---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import TagChip from '../../components/blog/tag-chip.astro';
import TraceCorners from '../../components/ui/trace-corners.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) =>
    import.meta.env.PROD ? !p.data.draft : true,
  );
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'blog'> };

const { entry } = Astro.props;
const { Content } = await render(entry);

const formattedDate = entry.data.date.toLocaleDateString('es-PE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image ?? '/og.png'}
  type="article"
  publishedTime={entry.data.date.toISOString()}
>
  <div class="mx-auto w-full max-w-3xl px-2 pt-24 pb-12 sm:px-0">
    <article
      class="relative rounded-lg border border-border backdrop-blur-sm backdrop-saturate-150"
    >
      <TraceCorners />
      <div class="p-4">
        <a
          href="/blog"
          class="mb-4 inline-block font-mono text-xs text-muted-foreground transition-colors hover:text-foreground"
        >
          ← Blog
        </a>
        <h1
          class="font-display mb-2 text-3xl font-semibold tracking-wide text-foreground"
          data-reveal="fade-up"
          style="--reveal-delay: 150ms;"
        >
          {entry.data.title}
        </h1>
        <div
          class="mb-4 flex flex-wrap items-center gap-3"
          data-reveal="fade-up"
          style="--reveal-delay: 250ms;"
        >
          <span class="font-mono text-xs text-muted-foreground">
            {formattedDate}
          </span>
          {
            entry.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {entry.data.tags.map((tag) => (
                  <TagChip tag={tag} />
                ))}
              </div>
            )
          }
        </div>
      </div>
      <div class="trace-hatched" data-reveal="trace-hatched"></div>
      <div
        class="prose prose-sm dark:prose-invert max-w-none p-4 text-sm leading-relaxed text-muted-foreground prose-strong:text-foreground prose-a:text-primary prose-a:no-underline hover:prose-a:underline"
        data-reveal="fade-up"
        style="--reveal-delay: 350ms;"
      >
        <Content />
      </div>
    </article>
  </div>
</Layout>
